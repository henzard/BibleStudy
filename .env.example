# Environment Variables Template
# Copy this file to .env and fill in your actual values.
# Everything here is optional — the project (and the early-warning pipeline)
# runs offline with deterministic fallbacks when keys are absent.

# ---------------------------------------------------------------------------
# LLM provider (early-warning research agents + executive report, newsletters)
# ---------------------------------------------------------------------------
# Provider selection: auto | anthropic | openai | none   (default: auto)
#   auto -> use Anthropic if its key is set, else OpenAI, else offline heuristic
LLM_PROVIDER=auto

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Data source API keys (network ingestion layer — fetch_*.py scripts)
# ---------------------------------------------------------------------------
# FRED economic data — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# EIN News RSS (World Bank news) — https://worldbank.einnews.com/rss/
EINNEWS_RSS_KEY=

# ---------------------------------------------------------------------------
# Early-warning pipeline tuning (optional)
# ---------------------------------------------------------------------------
PROPHECY_DB_PATH=data/prophecy_tracking.db
PIPELINE_LOOKBACK_DAYS=7
PIPELINE_TREND_WEEKS=8
PIPELINE_MAX_WORKERS=6

# ---------------------------------------------------------------------------
# Alert delivery channels (all opt-in). Outward sending is disabled by default
# (ALERTS_DRY_RUN=true). Set ALERTS_DRY_RUN=false to actually send.
# ---------------------------------------------------------------------------
ALERTS_DRY_RUN=true

# Alert routing: minimum level that triggers each channel (GREEN|WATCH|AMBER|RED)
SLACK_MIN_LEVEL=AMBER
TELEGRAM_MIN_LEVEL=RED
EMAIL_MIN_LEVEL=AMBER
# Only notify when the level rose / a fresh change occurred (avoids alert fatigue)
ALERT_NOTIFY_ONLY_ON_CHANGE=true
# Suppress repeat notifications at the same level within this window (hours)
ALERT_COOLDOWN_HOURS=6

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP)
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Dashboard JSON snapshot path
DASHBOARD_PATH=tracking/dashboard/latest.json
